# App
APP_NAME=FIFA AI Score Prediction API
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# Supabase — get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co/rest/v1/
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_JWT_SECRET=your_jwt_secret

# Database (direct connection string, from Supabase project settings)
DATABASE_URL=postgresql://postgres.your-project:your-password@your-pooler-host:5432/postgres

# CORS
ALLOWED_ORIGINS=["http://localhost:3000"]

# ML
MODEL_PATH=app/ml/models/xgboost_model.pkl
SCALER_PATH=app/ml/models/scaler.pkl
MODEL_VERSION=1.0.0

# ── Prediction engine ───────────────────────────────────────────────────────
# legacy (default): the existing predictor (v1.0.0, or V2 when USE_V2_MODEL=true).
# v3: opt-in. app.ml.v3, served from the committed match corpus. See docs/ml/.
PREDICTION_ENGINE=legacy

# ── V2 model (only consulted when PREDICTION_ENGINE=legacy) ─────────────────
# Master switch. MUST stay false until V2 is approved for production.
USE_V2_MODEL=false
# Which V2 bundle to serve when USE_V2_MODEL=true:
#   true  -> v2_production_calibrated (trained through 2026; for future matches)
#   false -> v2_backtest_calibrated  (frozen at 2022; reproduces the WC2026 backtest)
V2_USE_PRODUCTION_MODEL=true
# V2 feature-engine data source: "supabase" (production; reads matches_v2 etc.)
# or "csv" (local dev/offline fallback).
V2_DATA_SOURCE=supabase

# ── Rate limiting ───────────────────────────────────────────────────────────
# Counters live in public.rate_limit_buckets so the limit is shared across
# uvicorn workers (render.yaml runs --workers 2); a per-process limiter would
# let a client take 2x the limit.
RATE_LIMIT_ENABLED=true
# One request per predict-form submission; headroom for exploring matchups.
RATE_LIMIT_PREDICT_PER_MINUTE=30
# 5-9s of multi-process CPU per call — deliberately much stricter.
RATE_LIMIT_SIMULATE_PER_MINUTE=5
